<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ثيم نافذة أندرويد أثناء الإقلاع وقبل تحميل فلاتر (الوضع الفاتح) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar.Fullscreen">
        <!-- شاشة الإقلاع الأصلية بدون شريط الحالة -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <!-- إزالة الظل الافتراضي لشريط الحالة -->
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- ثيم نافذة أندرويد المستمر خلف واجهات فلاتر أثناء التشغيل -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>